{
  "name": "omp-desktop",
  "private": true,
  "scripts": {
    "host": "bun host/host.ts",
    "smoke": "bun scripts/smoke.ts",
    "smoke:queue": "bun scripts/queue-smoke.ts",
    "smoke:features": "bun scripts/smoke-features.ts",
    "smoke:branch": "bun scripts/smoke-branch.ts",
    "ui:build": "esbuild ui-src/main.jsx --bundle --format=iife --outfile=ui/assets/app.js --jsx=automatic --minify --define:process.env.NODE_ENV='\"production\"'",
    "ui:watch": "esbuild ui-src/main.jsx --bundle --format=iife --outfile=ui/assets/app.js --jsx=automatic --watch",
    "smoke:react": "bun scripts/smoke-react-shell.ts",
    "smoke:stamp": "bun scripts/smoke-stamp.ts",
    "check:capabilities": "node scripts/check-capabilities.mjs",
    "check:boundaries": "node scripts/check-host-boundaries.mjs",
    "check": "node scripts/check-capabilities.mjs && node scripts/check-host-boundaries.mjs"
  },
  "dependencies": {
    "@oh-my-pi/pi-agent-core": "18.2.6",
    "@oh-my-pi/pi-ai": "^18.2.6",
    "@oh-my-pi/pi-catalog": "^18.2.6",
    "@oh-my-pi/pi-coding-agent": "^18.2.5",
    "@oh-my-pi/pi-natives": "18.2.6",
    "@oh-my-pi/pi-tui": "^18.2.7",
    "@oh-my-pi/pi-utils": "^18.2.6",
    "@oh-my-pi/omptype": "^18.2.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4",
    "tokscale": "^4.17.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5"
  }
}