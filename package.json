{
  "name": "omp-desktop",
  "private": true,
  "scripts": {
    "host": "bun host/host.ts",
    "host:build": "bun scripts/build-host.ts",
    "smoke": "OMP_PROFILE=omp-desktop-test bun scripts/smoke.ts",
    "smoke:queue": "OMP_PROFILE=omp-desktop-test bun scripts/queue-smoke.ts",
    "smoke:features": "OMP_PROFILE=omp-desktop-test bun scripts/smoke-features.ts",
    "smoke:plan": "OMP_PROFILE=omp-desktop-test bun scripts/smoke-plan-approve.ts",
    "dev": "bun run ui:build && tauri dev",
    "ui:build": "vite build",
    "ui:watch": "vite build --watch",
    "ui:dev": "vite",
    "ui:typecheck": "tsc --noEmit",
    "smoke:react": "OMP_PROFILE=omp-desktop-test bun scripts/smoke-react-shell.ts",
    "smoke:stamp": "OMP_PROFILE=omp-desktop-test bun scripts/smoke-stamp.ts",
    "smoke:plugins": "OMP_PROFILE=omp-desktop-test bun scripts/smoke-plugins.ts",
    "smoke:project-group": "OMP_PROFILE=omp-desktop-test bun scripts/smoke-project-group.ts",
    "smoke:browsermirrorui": "OMP_PROFILE=omp-desktop-test bun run ui:build && OMP_PROFILE=omp-desktop-test bun scripts/smoke-browser-mirror-ui.ts",
    "check:capabilities": "node scripts/check-capabilities.mjs",
    "check:boundaries": "node scripts/check-host-boundaries.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check": "node scripts/check-capabilities.mjs && node scripts/check-host-boundaries.mjs && node scripts/check-style-tokens.mjs && node scripts/check-architecture.mjs && node scripts/check-comment-language.mjs && node scripts/check-encoding.mjs && node scripts/check-omp-imports.mjs && bun run ui:typecheck"
  },
  "dependencies": {
    "@lexical/react": "^0.51.0",
    "@oh-my-pi/omp-stats": "18.5.0",
    "@oh-my-pi/omptype": "18.5.0",
    "@oh-my-pi/pi-agent-core": "18.5.0",
    "@oh-my-pi/pi-ai": "18.5.0",
    "@oh-my-pi/pi-catalog": "18.5.0",
    "@oh-my-pi/pi-coding-agent": "18.5.0",
    "@oh-my-pi/pi-natives": "18.5.0",
    "@oh-my-pi/pi-tui": "18.5.0",
    "@oh-my-pi/pi-utils": "18.5.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "lexical": "^0.51.0",
    "lucide-react": "^1.24.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "shiki": "^4",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tokscale": "^4.17.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
