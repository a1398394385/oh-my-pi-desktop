+// A subscription row prices its models at 0 (`zhipu-coding-plan`), and a provider
+// missing from the catalog has no row at all, so the only list rate left is the
+// same model id on another bundled provider. The dashboard reports API-equivalent
+// spend, so that card is the fallback. Built once: the bundled catalog is static.
+let costById: Map<string, ModelCost> | null = null;
+
+function bundledCostById(modelId: string): ModelCost | null {
+	if (!costById) {
+		costById = new Map();
+		for (const provider of getBundledProviders()) {
+			for (const model of getBundledModels(provider as GeneratedProvider)) {
+				if (hasBillableCost(model.cost) && !costById.has(model.id)) costById.set(model.id, model.cost);
+			}
+		}
+	}
+	return costById.get(modelId) ?? null;
+}
