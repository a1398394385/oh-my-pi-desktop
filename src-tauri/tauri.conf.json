{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "omp-desktop",
  "version": "0.2.0",
  "identifier": "com.xys.omp-desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "bun run ui:build && bun run host:build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "omp desktop",
        "width": 1280,
        "height": 820,
        "x": 300,
        "y": 130,
        "minWidth": 700,
        "minHeight": 480,
        "backgroundColor": "#292B2C",
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "visible": false,
        "trafficLightPosition": {
          "x": 25,
          "y": 30
        },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico", "icons/icon.icns"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCMUE4NTc5RUNDMDdFQTgKUldTb2ZzRHNlWVVhcTd2R0Q4TVkrZ3dJV29JRXlWWkdCMGlBcnVjeC92dTR1aitKUkJWQUhETm8K",
      "endpoints": [
        "https://github.com/a1398394385/oh-my-pi-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
