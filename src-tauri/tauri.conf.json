{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "omp desktop",
  "version": "0.1.0",
  "identifier": "dev.omp.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "omp desktop",
        "width": 1440,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 620,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
