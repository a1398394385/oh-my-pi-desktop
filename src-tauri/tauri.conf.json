{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "omp-desktop",
  "version": "0.1.0",
  "identifier": "com.xys.omp-desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "omp desktop",
        "width": 1280,
        "height": 820,
        "x": 300,
        "y": 130,
        "minWidth": 700,
        "minHeight": 480
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.icns"]
  }
}
