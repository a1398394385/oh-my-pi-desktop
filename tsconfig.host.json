// Host typecheck, full coverage: every host/**/*.ts file.
// The root tsconfig only covers ui-src, so host/ needs this project to be typed at all.
// lib/target follow the Bun runtime (ES2024); bun-types supplies Bun/bun:* globals.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["bun"],
    "lib": ["ES2024", "DOM"],
    "allowImportingTsExtensions": true
  },
  "include": ["host/**/*.ts"]
}
